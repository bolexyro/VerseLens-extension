{
  "manifest_version": 3,
  "name": "VerseLens",
  "version": "1.0",
  "description": "A Chrome extension for bible study",
  "permissions": ["sidePanel"],
  "action": {
    "default_title": "Open Verselens Side panel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
