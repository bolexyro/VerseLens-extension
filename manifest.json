{
  "manifest_version": 3,
  "name": "VerseLens",
  "version": "1.0",
  "description": "A Chrome extension for bible study",
  "permissions": ["sidePanel", "activeTab", "scripting"],
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "exclude_matches": [
        "https://www.bible.com/*",
        "https://www.google.com/search*",
        "https://www.bing.com/search*",
        "https://search.yahoo.com/*",
        "https://duckduckgo.com/*"
      ],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_title": "Open Verselens Side panel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
